        "import random\n",
        "\n",
        "wins = 0\n",
        "episodes = 10\n",
        "\n",
        "for episode in range(episodes):\n",
        "    reward = random.choice([1, -1])\n",
        "\n",
        "    if reward == 1:\n",
        "        wins += 1\n",
        "\n",
        "print(\"Wins:\", wins)"
      ]
