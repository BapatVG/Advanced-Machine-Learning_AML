      "source": [
        "import numpy as np\n",
        "\n",
        "# Rewards\n",
        "bandits = [0.2, 0.5, 0.75, 0.3]\n",
        "\n",
        "# Random selection\n",
        "for i in range(10):\n",
        "    choice = np.random.randint(len(bandits))\n",
        "    reward = np.random.rand() < bandits[choice]\n",
        "\n",
        "    print(\"Bandit:\", choice)\n",
        "    print(\"Reward:\", reward)"
      ]
